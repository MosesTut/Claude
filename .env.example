# Timbuktoo Environment Configuration

# AI Provider
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/timbuktoo
VECTOR_DB_PATH=./data/vector_db

# Tool APIs
WEATHER_API_KEY=your_weather_api_key
EVENTS_API_KEY=your_events_api_key

# Cost Controls
MAX_TRIP_COST_USD=0.80
MAX_TOKENS_PER_AGENT=38000
VECTOR_CHUNKS_LIMIT=35

# Security
ENCRYPTION_KEY=your_encryption_key_here
JWT_SECRET=your_jwt_secret_here

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Monitoring
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
